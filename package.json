{
  "name": "xiaozhao-gaogaoshou",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/server/main.js",
    "profile:import": "node dist/server/server/import-cli.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:legacy": "python -X utf8 -m unittest -q",
    "eval:jobs": "node --experimental-strip-types scripts/evaluate-jobs.ts"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
