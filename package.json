{
  "name": "xiaozhao-gaogaoshou",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "desktop:install": "npm --prefix products/shizhi-desktop ci --ignore-scripts",
    "desktop:prepare": "npm --prefix products/shizhi-desktop run prepare:runtime && npm --prefix products/shizhi-desktop run prepare:electron",
    "desktop": "npm --prefix products/shizhi-desktop start",
    "desktop:dist": "npm --prefix products/shizhi-desktop run dist",
    "coach:install": "npm --prefix products/shizhi-interview ci",
    "coach": "npm --prefix products/shizhi-interview start",
    "coach:check": "npm --prefix products/shizhi-interview run verify",
    "dev": "npm run build && npm start",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "npm run coach",
    "start:workbench": "node dist/server/server/main.js",
    "profile:import": "node dist/server/server/import-cli.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:legacy": "python -X utf8 -m unittest discover -s products/legacy-desktop -q",
    "eval:jobs": "node --experimental-strip-types scripts/evaluate-jobs.ts"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "imapflow": "2.0.5",
    "mailparser": "3.9.28",
    "parse5": "8.0.1",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
