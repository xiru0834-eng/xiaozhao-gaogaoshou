{
  "name": "@deepseek-ai/dsh-shizhi-interview",
  "version": "0.1.0",
  "description": "拾知面试陪练：本地保存练习，语音口述，针对回答反馈与重练。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-career.mjs",
    "prepack": "npm run build",
    "test": "node --test test/**/*.test.js",
    "test:domain": "node --test test/domain/*.test.js",
    "test:application": "node --test test/application/*.test.js",
    "test:storage": "node --test test/infrastructure/*.test.js",
    "check": "node --check lib/index.js && node --check src/adapters/dsh/plugin.js && node --check client/client.js",
    "verify": "npm run build && npm test && npm run check",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.6-alpha.2",
    "esbuild": "^0.25.9",
    "parse5": "8.0.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md",
    ".env.example"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "interview",
    "interview-practice"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN NOTICE.md",
  "private": true
}
