# Optional: configure this in the Harness settings UI instead.
DEEPSEEK_API_KEY=

# Alibaba Cloud Model Studio, China (Beijing). Fill in your Beijing API key.
# Other multipart transcription services use SHIZHI_ASR_PROVIDER=multipart.
# Clear both URL and model to use browser speech recognition instead.
SHIZHI_ASR_PROVIDER=qwen
SHIZHI_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
SHIZHI_ASR_MODEL=qwen3-asr-flash
SHIZHI_ASR_API_KEY=

SHIZHI_PORT=4317
